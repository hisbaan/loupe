# Where users reach Loupe. In dev this is the Vite server, which proxies to the API.
LOUPE_PUBLIC_URL=http://localhost:5173
LOUPE_ADDR=0.0.0.0:3000
LOUPE_DATABASE_URL=sqlite://loupe.db
LOUPE_WEB_DIR=../web/dist

# Encrypts GitHub tokens at rest. Generate with: openssl rand -base64 32
# Changing it signs everyone out.
LOUPE_SECRET_KEY=

# From your GitHub App (Settings → Developer settings → GitHub Apps).
# Callback URL: $LOUPE_PUBLIC_URL/auth/github/callback
# Permissions: Contents (read), Pull requests (read), Metadata (read).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: point at an OpenAI-compatible endpoint (defaults to https://api.openai.com/v1).
# LOUPE_OPENAI_BASE_URL=

RUST_LOG=loupe_api=debug,tower_http=info
