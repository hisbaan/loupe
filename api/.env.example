# Where users reach Loupe. In dev this is the Vite server, which proxies to the API.
LOUPE_PUBLIC_URL=http://localhost:5173
LOUPE_ADDR=0.0.0.0:3000
LOUPE_DATABASE_URL=sqlite://loupe.db
LOUPE_WEB_DIR=../web/dist

# Encrypts GitHub tokens at rest. Generate with: openssl rand -base64 32
# Changing it signs everyone out.
LOUPE_SECRET_KEY=

# Loupe's GitHub App. Leave these empty on first start: the server then runs in
# setup mode and logs a setup token. Open $LOUPE_PUBLIC_URL/setup, enter it, and
# GitHub creates the app; paste the lines it gives you here and restart.
# (Manual alternative: create a GitHub App with callback URL
# $LOUPE_PUBLIC_URL/auth/github/callback and read-only Contents, Pull requests
# and Metadata permissions.)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The app's URL name, for "install the app" links. Optional.
GITHUB_APP_SLUG=

# Optional: point at an OpenAI-compatible endpoint (defaults to https://api.openai.com/v1).
# LOUPE_OPENAI_BASE_URL=

RUST_LOG=loupe_api=debug,tower_http=info
